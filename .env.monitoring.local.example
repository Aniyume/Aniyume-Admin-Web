# Self-contained monitoring URLs for local/admin standalone runs.
# These values assume the Docker monitoring stack is published to localhost.
# Update them if you run the tools on different hosts/ports.

NEXT_PUBLIC_UPTIME_KUMA_URL=http://localhost:3001
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3002
NEXT_PUBLIC_NOCODB_URL=http://localhost:8080

NEXT_PUBLIC_UPTIME_KUMA_EMBED=false
NEXT_PUBLIC_GRAFANA_EMBED=false
NEXT_PUBLIC_NOCODB_EMBED=false
