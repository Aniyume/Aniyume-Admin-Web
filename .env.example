NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8080

# Temporary admin auth shell only: no real secrets should be committed.
# Bearer tokens are not configured here. Prefer backend-issued HttpOnly cookies when available.
# If your backend later supports admin login, add only public endpoint settings here.

# CI/Docker notes:
# - NEXT_PUBLIC_ADMIN_API_BASE_URL is a public Next.js build-time value.
# - For production Docker builds, pass it as a build arg with the public backend origin.
# - Do not put admin bearer tokens, API keys, passwords, or cookie secrets in this file.
