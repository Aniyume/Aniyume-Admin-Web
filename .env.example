NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8080

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=aniyume_admin

# CI/Docker notes:
# - NEXT_PUBLIC_ADMIN_API_BASE_URL is a public Next.js build-time value.
# - For production Docker builds, pass it as a build arg with the public backend origin.
# - Do not put admin bearer tokens, passwords, private keys, or real secrets in this file.
