NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8080
ADMIN_BACKEND_URL=http://backend:8000/api/v1

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=aniyume_admin

# Monitoring tools opened by the admin frontend
NEXT_PUBLIC_UPTIME_KUMA_URL=http://localhost:3001
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3002
NEXT_PUBLIC_NOCODB_URL=http://localhost:8080

# Enable only after the service is explicitly configured to allow iframe embedding
NEXT_PUBLIC_UPTIME_KUMA_EMBED=false
NEXT_PUBLIC_GRAFANA_EMBED=false
NEXT_PUBLIC_NOCODB_EMBED=false

# CI/Docker notes:
# - NEXT_PUBLIC_ADMIN_API_BASE_URL is a public Next.js build-time value.
# - For production Docker builds, pass it as a build arg with the public backend origin.
# - Do not put admin bearer tokens, passwords, private keys, or real secrets in this file.
